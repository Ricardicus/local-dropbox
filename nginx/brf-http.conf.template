server {
  listen 80;
  server_name brfrynningeasen.se www.brfrynningeasen.se;

  # Certbot on .150 writes here; challenges from .197 fall back to its server.
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri @brf_backend_challenge;
  }

  location @brf_backend_challenge {
    proxy_pass http://192.168.1.197:80;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto http;
    proxy_connect_timeout 10s;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

