upstream hallevault {
  server hallevault:8080;
}

server {
  listen 80;
  server_name hallevault.ricardicus.se;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
  }

  location / {
    return 301 https://hallevault.ricardicus.se$request_uri;
  }
}

server {
  listen 443 ssl;
  server_name hallevault.ricardicus.se;

  ssl_certificate /etc/letsencrypt/live/hallevault.ricardicus.se/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/hallevault.ricardicus.se/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:HallevaultSSL:10m;
  ssl_session_timeout 1d;

  client_max_body_size 200m;

  location / {
    proxy_pass http://hallevault;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }
}
